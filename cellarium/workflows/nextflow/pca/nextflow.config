/*
 * Nextflow configuration for running the cellarium PCA pipeline
 * on Google Cloud Batch.
 *
 * This file is auto-detected by Nextflow when it lives next to pca.nf.
 * Override any param on the command line, e.g.:
 *   nextflow run pca.nf --spot true --disk_size '750 GB'
 */

plugins {
    id 'nf-google'
}

// ── Tunable parameters ─────────────────────────────────────────────────────
params {
    // Google Cloud project and region
    google_project = 'broad-dsde-methods'
    google_region  = 'us-central1'

    // GCS path Nextflow uses for task staging and intermediate files.
    // Must be a gs:// URI; separate from params.output_bucket in pca.nf.
    work_bucket    = 'gs://cellarium-dev-central/workflows/tmp'

    // Use spot (preemptible) VMs. Set --spot true to cut costs ~70%.
    // With maxRetries = 2 below, spot evictions are handled automatically.
    spot           = false

    // Disk attached to each task VM.
    // diskType pd-ssd is NVMe-backed (~1.2 GB/s per TB).
    disk_size      = '750 GB'
}

// ── Work directory (must be GCS for Google Batch) ─────────────────────────
workDir = params.work_bucket

// ── Process defaults ───────────────────────────────────────────────────────
process {
    executor      = 'google-batch'
    disk          = params.disk_size
    diskType      = 'pd-ssd'
    maxRetries    = 0
    errorStrategy = 'retry'
}

// ── Google Cloud Batch settings ────────────────────────────────────────────
google {
    project  = params.google_project
    location = params.google_region

    batch {
        // Preemptible (spot) VMs; controlled via --spot param above.
        spot = params.spot
    }
}
