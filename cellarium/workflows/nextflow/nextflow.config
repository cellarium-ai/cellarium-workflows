/*
 * Nextflow configuration for cellarium-ml workflows.
 *
 * Usage:
 *   nextflow run <workflow>.nf -profile gcp    # Google Cloud Batch
 *   nextflow run <workflow>.nf -profile local  # local machine via conda
 *
 * Override any param on the command line, e.g.:
 *   nextflow run pca_workflow.nf -profile gcp --spot true
 */

plugins {
    id 'nf-google'
}

// ── Shared parameters ──────────────────────────────────────────────────────
params {
    // Container image used by all processes on GCP
    container  = 'us-central1-docker.pkg.dev/broad-dsde-methods/cellarium-ai/cellarium-ml:0.0.8'

    // Conda environment name used by all processes when running locally.
    // The named environment must already exist: conda activate cellarium-ml
    conda_env  = 'cellarium'

    // Google Cloud settings (used by the gcp profile)
    google_project = 'dsp-cellarium'
    google_region  = 'us-central1'
    work_bucket    = 'gs://cellarium-dev-central/workflows/tmp'

    // Use spot (preemptible) VMs. Set --spot true to cut costs ~70%.
    // With maxRetries = 2, spot evictions are handled automatically.
    spot       = false

    // Disk attached to each GCP task VM.
    // 750 GB = ~600 GB dataset + OS/container + outputs.
    // pd-ssd is NVMe-backed (~1.2 GB/s per TB).
    disk_size  = '750 GB'
}

// ── Process defaults (apply to all profiles) ──────────────────────────────
process {
    scratch       = true
    maxRetries    = 2
    errorStrategy = 'retry'
}

// ── Profiles ───────────────────────────────────────────────────────────────
profiles {

    // Run on local machine using a conda environment (no Docker needed).
    // The named conda environment must already exist.
    local {
        process.executor = 'local'
        conda.enabled    = true
        process {
            conda = params.conda_env
        }
    }

    // Run on Google Cloud Batch with per-process hardware configuration.
    gcp {
        workDir = params.work_bucket

        process {
            executor  = 'google-batch'
            container = params.container
            disk      = params.disk_size
            diskType  = 'pd-ssd'

            withName: 'ONEPASS_MEAN_VAR' {
                machineType = 'n1-standard-16'
                accelerator = [request: 1, type: 'nvidia-tesla-t4']
            }
            withName: 'HIGHLY_VARIABLE_GENES' {
                machineType = 'n1-standard-16'
                accelerator = [request: 1, type: 'nvidia-tesla-t4']
            }
            withName: 'INCREMENTAL_PCA' {
                machineType = 'n1-standard-16'
                accelerator = [request: 1, type: 'nvidia-tesla-t4']
            }
            withName: 'INCREMENTAL_PCA_PREDICT' {
                machineType = 'n1-standard-16'
                accelerator = [request: 1, type: 'nvidia-tesla-t4']
            }
        }

        google {
            project  = params.google_project
            location = params.google_region
            batch {
                spot = params.spot
            }
        }
    }

}
